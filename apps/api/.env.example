# =====================================================================
#  API environment — copy to apps/api/.env and fill in
#  This file is a TEMPLATE. Never commit real values.
# =====================================================================

NODE_ENV=development
PORT=3001

# ---- Deployment label ------------------------------------------------
# Shown as a badge next to the WCPSS badge on the sign-in page, so staff
# know which environment they are signing into. Leave blank for production.
#   test:       MODE=TEST SITE
#   production:  MODE=
MODE=

# ---- Azure SQL -------------------------------------------------------
AZURE_SQL_SERVER=<your-server>.database.windows.net
AZURE_SQL_DATABASE=<database-name>
AZURE_SQL_USER=<sql-user>
AZURE_SQL_PASSWORD=<sql-password>

# ---- JWT -------------------------------------------------------------
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_DAYS=7

# ---- CORS ------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173

# ---- Super administrator (seeded once, on first boot) ----------------
# After the first successful boot this becomes a normal row in
# core.AppUser and can be managed from the Admin screen. Changing these
# values later does NOT reset the existing account.
SUPER_ADMIN_EMAIL=<admin-email>
SUPER_ADMIN_PASSWORD=<strong-password-min-8-chars>
SUPER_ADMIN_NAME=Super Administrator
